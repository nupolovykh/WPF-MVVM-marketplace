<Application x:Class="Marketplace.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="clr-namespace:Marketplace.Wpf.ViewModels"
             xmlns:views="clr-namespace:Marketplace.Wpf.Views">

    <Application.Resources>

        <ResourceDictionary>
            
            <DataTemplate DataType="{x:Type viewmodels:YourDeliveryInfoVM}">
                <views:YourDeliveryInfo />
            </DataTemplate>

			<DataTemplate DataType="{x:Type viewmodels:HomeVM}">
				<views:Home />
			</DataTemplate>

			<DataTemplate DataType="{x:Type viewmodels:AuthorizationVM}">
                <views:Authorization />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:RegistrationVM}">
                <views:Registration/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:StatisticsVM}">
                <views:Statistics />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:ProfileVM}">
                <views:Profile />
            </DataTemplate>
            
        </ResourceDictionary>

    </Application.Resources>
</Application>
